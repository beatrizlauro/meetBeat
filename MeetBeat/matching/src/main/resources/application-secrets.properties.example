# Modelo do arquivo de segredos. Copie para application-secrets.properties (mesma pasta)
# e preencha os valores. O arquivo real é ignorado pelo Git e nunca deve ser versionado.

# Senha de acesso ao banco Neo4j
spring.neo4j.authentication.password=

# Chave secreta (HMAC-SHA256, Base64, 32 bytes) usada para assinar os tokens JWT.
# Para gerar uma nova (Git Bash):  openssl rand -base64 32
jwt.secret=

# Conta remetente (SMTP) do fluxo de recuperação de senha. Com Gmail, use uma "senha de app".
spring.mail.username=
spring.mail.password=
