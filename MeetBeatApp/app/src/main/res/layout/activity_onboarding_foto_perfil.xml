<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/purple_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/btnVoltarOnboarding"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="←"
            android:textSize="26sp"
            android:textColor="@color/purple_primary"
            android:textStyle="bold"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Passo 3 de 4"
            android:textColor="@color/text_gray"
            android:textSize="13sp"
            android:gravity="center" />

        <View
            android:layout_width="42dp"
            android:layout_height="1dp" />

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:text="Escolha uma foto de perfil"
        android:textColor="@color/purple_primary"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <FrameLayout
            android:layout_width="180dp"
            android:layout_height="180dp">

            <ImageView
                android:id="@+id/imageFotoPerfilOnboarding"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_avatar_circle" />

            <TextView
                android:id="@+id/textPlaceholderIconePerfil"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="😎"
                android:textSize="48sp" />

        </FrameLayout>

        <TextView
            android:id="@+id/btnEscolherFotoPerfilOnboarding"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Escolher foto"
            android:textColor="@color/purple_primary"
            android:textStyle="bold"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <TextView
        android:id="@+id/btnPularFotoPerfil"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="Pular por enquanto"
        android:textColor="@color/text_gray"
        android:textSize="14sp"
        android:padding="8dp"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/btnContinuarFotoPerfil"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_margin="20dp"
        android:background="@drawable/bg_button_accept"
        android:gravity="center"
        android:text="Continuar"
        android:textColor="#27AE60"
        android:textStyle="bold"
        android:textSize="16sp"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>