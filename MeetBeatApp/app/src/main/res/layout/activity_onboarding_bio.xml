<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/purple_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/btnVoltarOnboarding"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="←"
            android:textSize="26sp"
            android:textColor="@color/purple_primary"
            android:textStyle="bold"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Passo 2 de 4"
            android:textColor="@color/text_gray"
            android:textSize="13sp"
            android:gravity="center" />

        <View
            android:layout_width="42dp"
            android:layout_height="1dp" />

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:text="Conte um pouco sobre você"
        android:textColor="@color/purple_primary"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp">

            <EditText
                android:id="@+id/editBioOnboarding"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/card_background"
                android:padding="16dp"
                android:hint="Fale sobre seus artistas favoritos, shows que já foi, o que procura por aqui..."
                android:gravity="top"
                android:minLines="4"
                android:inputType="textMultiLine" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Música favorita"
                android:textColor="@color/text_gray"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/editMusicaFavorita"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/card_background"
                android:padding="12dp"
                android:layout_marginTop="4dp"
                android:hint="Ex: Standing Next to You" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Artista favorito"
                android:textColor="@color/text_gray"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/editArtistaFavorito"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/card_background"
                android:padding="12dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"
                android:hint="Ex: BTS" />

        </LinearLayout>

    </ScrollView>

    <TextView
        android:id="@+id/btnPularBio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="Pular por enquanto"
        android:textColor="@color/text_gray"
        android:textSize="14sp"
        android:padding="8dp"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/btnContinuarBio"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_margin="20dp"
        android:background="@drawable/bg_button_accept"
        android:gravity="center"
        android:text="Continuar"
        android:textColor="#27AE60"
        android:textStyle="bold"
        android:textSize="16sp"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>