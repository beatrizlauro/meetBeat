<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/bg_gradient_login"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MEET&amp;BEAT"
        android:textColor="@color/purple_primary"
        android:textSize="32sp"
        android:fontFamily="@font/antonio_bold"
        android:layout_marginBottom="40dp" />

    <EditText
        android:id="@+id/editNomeLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_input_field"
        android:elevation="2dp"
        android:textColor="@color/text_dark"
        android:textColorHint="@color/text_gray"
        android:padding="14dp"
        android:hint="Nome de usuário (ex: jimin)" />

    <EditText
        android:id="@+id/editSenhaLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_input_field"
        android:elevation="2dp"
        android:textColor="@color/text_dark"
        android:textColorHint="@color/text_gray"
        android:padding="14dp"
        android:layout_marginTop="16dp"
        android:hint="Senha"
        android:inputType="textPassword" />

    <TextView
        android:id="@+id/btnEsqueciSenha"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="8dp"
        android:text="Esqueci minha senha"
        android:textColor="@color/purple_primary"
        android:textSize="13sp"
        android:padding="8dp"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/btnEntrar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_button_accept"
        android:elevation="4dp"
        android:gravity="center"
        android:text="Entrar"
        android:textColor="@color/vidro_conteudo_claro"
        android:textStyle="bold"
        android:textSize="16sp"
        android:clickable="true"
        android:focusable="true" />

    <LinearLayout
        android:id="@+id/btnLoginGoogle"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_button_google"
        android:elevation="4dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_google_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Continuar com Google"
            android:textColor="@color/text_dark"
            android:textStyle="bold"
            android:textSize="15sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/btnIrParaCadastro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Não tem conta? Criar perfil"
        android:textColor="@color/purple_primary"
        android:textStyle="bold"
        android:padding="8dp"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>