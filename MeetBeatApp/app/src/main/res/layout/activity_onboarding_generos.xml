<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/purple_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <ImageView
            android:id="@+id/btnVoltarOnboarding"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@drawable/ic_back"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Passo 1 de 4"
            android:textColor="@color/text_gray"
            android:textSize="13sp"
            android:gravity="center" />

        <View
            android:layout_width="42dp"
            android:layout_height="1dp" />

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:text="Quais estilos musicais você curte?"
        android:textColor="@color/purple_primary"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerGeneros"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="16dp" />

    <TextView
        android:id="@+id/btnContinuarGeneros"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_margin="20dp"
        android:background="@drawable/bg_button_accept"
        android:elevation="4dp"
        android:gravity="center"
        android:text="Continuar"
        android:textColor="@color/vidro_conteudo_claro"
        android:textStyle="bold"
        android:textSize="16sp"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>