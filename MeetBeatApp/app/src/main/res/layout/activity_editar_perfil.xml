<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/purple_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="16dp">

            <ImageView
                android:id="@+id/btnVoltarEditarPerfil"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:src="@drawable/ic_back"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Editar Perfil"
                android:textColor="@color/purple_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center" />

            <View
                android:layout_width="42dp"
                android:layout_height="1dp" />

        </LinearLayout>

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center">

            <ImageView
                android:id="@+id/imageFotoPerfilEditar"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_avatar_placeholder" />

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/bg_button_accept"
                android:elevation="4dp"
                android:padding="7dp"
                android:src="@drawable/ic_edit" />

        </FrameLayout>

        <TextView
            android:id="@+id/btnTrocarFotoPerfil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:text="Trocar foto de perfil"
            android:textColor="@color/purple_primary"
            android:textStyle="bold"
            android:textSize="14sp"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true" />

        <!-- Foto do feed (a que aparece no card de sugestões para os outros usuários) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Foto do feed"
            android:textColor="@color/text_gray"
            android:textSize="14sp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:cardBackgroundColor="@color/card_background"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <ImageView
                android:id="@+id/imageFotoFeedEditar"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:scaleType="centerCrop"
                android:contentDescription="Foto exibida no feed"
                android:clickable="true"
                android:focusable="true" />

        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnTrocarFotoFeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trocar foto do feed"
                android:textColor="@color/purple_primary"
                android:textStyle="bold"
                android:textSize="14sp"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnRemoverFotoFeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Remover"
                android:textColor="@color/cor_erro"
                android:textStyle="bold"
                android:textSize="14sp"
                android:padding="8dp"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <!-- Nome -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Nome"
            android:textColor="@color/text_gray"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/editNomeEditar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input_field"
            android:elevation="2dp"
            android:textColor="@color/text_dark"
            android:textColorHint="@color/text_gray"
            android:padding="12dp"
            android:layout_marginTop="4dp"
            android:hint="Seu nome"
            android:maxLength="80" />

        <!-- Username -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Nome de usuário"
            android:textColor="@color/text_gray"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/editUsernameEditar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input_field"
            android:elevation="2dp"
            android:textColor="@color/text_dark"
            android:textColorHint="@color/text_gray"
            android:padding="12dp"
            android:layout_marginTop="4dp"
            android:hint="Ex: jungkook"
            android:maxLength="30"
            android:inputType="textVisiblePassword|textNoSuggestions" />

        <!-- E-mail -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="E-mail"
            android:textColor="@color/text_gray"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/editEmailEditar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input_field"
            android:elevation="2dp"
            android:textColor="@color/text_dark"
            android:textColorHint="@color/text_gray"
            android:padding="12dp"
            android:layout_marginTop="4dp"
            android:hint="seu@email.com (usado para recuperar a senha)"
            android:inputType="textEmailAddress"
            android:maxLength="254" />

        <!-- Bio -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Bio"
            android:textColor="@color/text_gray"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/editBioEditar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input_field"
            android:elevation="2dp"
            android:textColor="@color/text_dark"
            android:textColorHint="@color/text_gray"
            android:padding="12dp"
            android:layout_marginTop="4dp"
            android:hint="Fale sobre seus artistas favoritos, shows que já foi..."
            android:gravity="top"
            android:minLines="3"
            android:maxLength="@integer/max_caracteres_bio"
            android:inputType="textMultiLine|textCapSentences" />

        <TextView
            android:id="@+id/textContadorBioEditar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_gray"
            android:textSize="12sp" />

        <!-- Música favorita -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Música favorita"
            android:textColor="@color/text_gray"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/editMusicaEditar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input_field"
            android:elevation="2dp"
            android:textColor="@color/text_dark"
            android:textColorHint="@color/text_gray"
            android:padding="12dp"
            android:layout_marginTop="4dp"
            android:hint="Ex: Standing Next to You"
            android:maxLength="120" />

        <!-- Artista favorito -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Artista favorito"
            android:textColor="@color/text_gray"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/editArtistaEditar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input_field"
            android:elevation="2dp"
            android:textColor="@color/text_dark"
            android:textColorHint="@color/text_gray"
            android:padding="12dp"
            android:layout_marginTop="4dp"
            android:hint="Ex: BTS"
            android:maxLength="120" />

        <!-- Nova senha -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Nova senha (opcional)"
            android:textColor="@color/text_gray"
            android:textSize="14sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">

            <EditText
                android:id="@+id/editNovaSenhaEditar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_field"
                android:elevation="2dp"
                android:textColor="@color/text_dark"
                android:textColorHint="@color/text_gray"
                android:hint="Deixe em branco para manter a atual"
                android:inputType="textPassword"
                android:maxLength="72"
                android:paddingStart="12dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:paddingEnd="48dp" />

            <ImageView
                android:id="@+id/btnMostrarNovaSenhaEditar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="4dp"
                android:padding="11dp"
                android:elevation="3dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Mostrar senha"
                android:src="@drawable/ic_olho"
                app:tint="@color/text_gray" />

        </FrameLayout>

        <TextView
            android:id="@+id/btnSalvarEdicaoPerfil"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_margin="20dp"
            android:background="@drawable/bg_button_accept"
            android:elevation="4dp"
            android:gravity="center"
            android:text="Salvar alterações"
            android:textColor="@color/vidro_conteudo_claro"
            android:textStyle="bold"
            android:textSize="16sp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</ScrollView>
