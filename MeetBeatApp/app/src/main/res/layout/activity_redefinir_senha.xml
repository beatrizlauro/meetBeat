<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/purple_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="16dp">

            <ImageView
                android:id="@+id/btnVoltarRedefinirSenha"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:src="@drawable/ic_back"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Redefinir Senha"
                android:textColor="@color/purple_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center" />

            <View
                android:layout_width="42dp"
                android:layout_height="1dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/textEmailRedefinirSenha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Enviamos um código para o seu e-mail"
            android:textColor="@color/text_gray"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Código de verificação"
            android:textColor="@color/text_gray"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/editCodigoRedefinirSenha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input_field"
            android:elevation="2dp"
            android:textColor="@color/text_dark"
            android:textColorHint="@color/text_gray"
            android:padding="12dp"
            android:layout_marginTop="4dp"
            android:hint="Ex: 123456"
            android:inputType="number"
            android:maxLength="6" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Nova senha"
            android:textColor="@color/text_gray"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/editNovaSenhaRedefinir"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input_field"
            android:elevation="2dp"
            android:textColor="@color/text_dark"
            android:textColorHint="@color/text_gray"
            android:padding="12dp"
            android:layout_marginTop="4dp"
            android:hint="Crie uma nova senha"
            android:inputType="textPassword" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Confirmar nova senha"
            android:textColor="@color/text_gray"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/editConfirmarSenhaRedefinir"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input_field"
            android:elevation="2dp"
            android:textColor="@color/text_dark"
            android:textColorHint="@color/text_gray"
            android:padding="12dp"
            android:layout_marginTop="4dp"
            android:hint="Repita a nova senha"
            android:inputType="textPassword" />

        <TextView
            android:id="@+id/btnReenviarCodigo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:text="Não recebeu? Reenviar código"
            android:textColor="@color/purple_primary"
            android:textStyle="bold"
            android:textSize="13sp"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btnConfirmarRedefinicao"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_button_accept"
            android:elevation="4dp"
            android:gravity="center"
            android:text="Redefinir senha"
            android:textColor="@color/vidro_conteudo_claro"
            android:textStyle="bold"
            android:textSize="16sp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</ScrollView>
