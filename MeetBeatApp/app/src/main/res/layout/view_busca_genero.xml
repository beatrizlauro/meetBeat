<?xml version="1.0" encoding="utf-8"?>
<!-- Barra de busca de gêneros, compartilhada pelo onboarding e pela edição de gêneros -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:layout_marginHorizontal="22dp"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_input_field"
    android:elevation="2dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="6dp">

    <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_search"
        app:tint="@color/purple_primary" />

    <EditText
        android:id="@+id/editBuscaGenero"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:background="@null"
        android:hint="Buscar gênero musical"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:maxLines="1"
        android:textColor="@color/text_dark"
        android:textColorHint="@color/text_gray"
        android:textSize="15sp" />

    <ImageView
        android:id="@+id/btnLimparBuscaGenero"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:padding="8dp"
        android:src="@drawable/ic_close"
        android:contentDescription="Limpar busca"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:tint="@color/text_gray" />

</LinearLayout>
