<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <application
        android:name=".MeetBeatApplication"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MeetBeat"
        tools:targetApi="31">

        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MeetBeat.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainContainerActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.MeetBeat" />

        <activity
            android:name=".MatchesActivity"
            android:exported="false"
            android:label="Meus Matches"
            android:theme="@style/Theme.MeetBeat" />

        <activity
            android:name=".MatchDetalheActivity"
            android:exported="false"
            android:label="Detalhes do Match"
            android:theme="@style/Theme.MeetBeat" />

        <activity
            android:name=".CadastroActivity"
            android:exported="false"
            android:label="Criar Perfil"
            android:theme="@style/Theme.MeetBeat" />

        <activity
            android:name=".OnboardingGenerosActivity"
            android:exported="false"
            android:label="Estilos musicais"
            android:theme="@style/Theme.MeetBeat" />

        <activity
            android:name=".OnboardingBioActivity"
            android:exported="false"
            android:label="Sobre você"
            android:theme="@style/Theme.MeetBeat" />

        <activity
            android:name=".OnboardingFotoActivity"
            android:exported="false"
            android:label="Foto de show"
            android:theme="@style/Theme.MeetBeat" />

        <activity
            android:name=".OnboardingFotoPerfilActivity"
            android:exported="false"
            android:label="Foto de perfil"
            android:theme="@style/Theme.MeetBeat" />

    </application>

</manifest>